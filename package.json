{
  "name": "@whlong/chatbase",
  "version": "0.1.1",
  "description": "Shared AI chat foundation for Cloudflare Workers: multi-provider chat, streaming, credits ledger and model catalog, as a Hono sub-app factory.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HarlonWang/chatbase.git"
  },
  "homepage": "https://github.com/HarlonWang/chatbase#readme",
  "keywords": [
    "ai",
    "chat",
    "llm",
    "openai",
    "cloudflare-workers",
    "hono"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./migrations/*": "./migrations/*"
  },
  "files": [
    "dist",
    "migrations",
    "docs/chat-protocol.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "hono": "^4.12.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "~0.13.1",
    "@cloudflare/workers-types": "~4.20260317.1",
    "hono": "^4.12.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "~4.74.0"
  },
  "allowScripts": {
    "workerd@1.20260312.1": true,
    "workerd@1.20260317.1": true
  },
  "publishConfig": {
    "access": "public"
  }
}
